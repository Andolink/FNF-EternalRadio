import funkin.play.song.Song;
import funkin.Paths;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.PlayStatePlaylist;

import funkin.play.PlayState;
import funkin.play.notes.NoteSprite;
import funkin.play.notes.Strumline;
import flixel.math.FlxMath;

class BillionMustShineSong extends Song {
  var hasPlayedCutscene:Bool;

	public function new() {
		super('billionmustshine');

    hasPlayedCutscene = false;
	}

  public override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);

    if (!PlayStatePlaylist.isStoryMode) hasPlayedCutscene = true;

    if (!hasPlayedCutscene) {
      trace('Pausing countdown to play a video cutscene (`billionmustshine`)');

      hasPlayedCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      startVideo();
    }
	}

  var offsetNeeded:Float = 0.0;
  var previousY:Float = 0.0;

  public override function onUpdate(event:UpdateScriptEvent):Void {
    var _strumline = PlayState.instance.opponentStrumline;
    _strumline.customRenderDistanceMs = 2000;
    _strumline.useCustomRenderDistance = true;

    if (_strumline.notes.members != null)
    {
      var _offsetStart = 14000.0;

      previousY = 0;

      for (note in _strumline.notes.members) {
        if (note != null)
        {
          if (note.strumTime > _offsetStart)
          {
            if (offsetNeeded == 0.0 && previousY != 0.0)
            {
                offsetNeeded = note.y - previousY;
            }
            note.yOffset = -offsetNeeded;
          }
          else {
            previousY = note.y;
            note.yOffset = 0.0;
          }
        }
      }

      if (previousY == 0)
      {
        if (offsetNeeded > 0 )
        {
          offsetNeeded = FlxMath.lerp(offsetNeeded,0,0.85);
        }
      }
    }
  }

  function startVideo() {
    VideoCutscene.play(Paths.videos('billionMustShineCutscene'));
  }

  /**
   * Don't replay the cutscene between restarts.
   */
  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    hasPlayedCutscene = true;
  }

  /**
   * Replay the cutscene after leaving the song.
   */
  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    hasPlayedCutscene = false;
  }
}
