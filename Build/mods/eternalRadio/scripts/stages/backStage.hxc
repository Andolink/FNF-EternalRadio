import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxAngle;
import funkin.Paths;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import flixel.addons.display.FlxTiledSprite;

class BackStageStage extends Stage
{
	function new()
	{
		super('backStage');
	}

	function onCreate(event:ScriptEvent):Void
	{
		super.onCreate(event);
	}

	var cadreBlood:FlxSprite; 
  	var clouds:FlxTiledSprite;
	var pupil:StageProp;

	override function buildStage()
	{
		super.buildStage();

		cadreBlood = new FlxSprite();
		cadreBlood.loadGraphic(Paths.image('cadreBlood'));
		cadreBlood.setPosition(0, 0);
    	cadreBlood.scrollFactor.set(0, 0);
		cadreBlood.width = FlxG.initialWidth;
		cadreBlood.height = FlxG.initialHeight;
		cadreBlood.zIndex = 600;
		cadreBlood.cameras = [PlayState.instance.camHUD];
		PlayState.instance.add(cadreBlood);

		pupil = getNamedProp('tankEye');
		var animLeft:FlxAnimation = pupil.animation.getByName('lookDad');
		animLeft.looped = false;
		var animRight:FlxAnimation = pupil.animation.getByName('lookBf');
		animRight.looped = false;
	}

	function onUpdate(event:UpdateScriptEvent):Void
	{
		super.onUpdate(event);
	}

	function onBeatHit(event:SongTimeScriptEvent):Void
	{
		super.onBeatHit(event);
	}

	function onSongRetry(event:ScriptEvent)
	{
		super.onSongRetry(event);
	}

	public override function onSongEvent(scriptEvent:SongEventScriptEvent)
	{
		super.onSongEvent(scriptEvent);

		if (scriptEvent.eventData.eventKind == "FocusCamera")
		{
			var eventProps = scriptEvent.eventData.value;
			switch (Std.parseInt(eventProps.char))
			{
				case 0:
				movePupilsRight();
				case 1:
				movePupilsLeft();
				default:
			}
		}
	}


	var pupilLeft:Bool = false; 

	function movePupilsLeft():Void
	{
		if (pupilLeft) return;
		trace('Move pupils left');
		pupil.animation.play('lookDad');
		pupilLeft = true;
		/*
		pupil.playAnimation('');
		pupil.anim.curFrame = 0;*/
		// pupilState = PUPIL_STATE_LEFT;
	}

	function movePupilsRight():Void
	{
		if (!pupilLeft) return;
		trace('Move pupils right');
		pupil.animation.play('lookBf');
		pupilLeft = false;
		/*pupil.playAnimation('');
		pupil.anim.curFrame = 17;*/
		// pupilState = PUPIL_STATE_NORMAL;
	}
}
